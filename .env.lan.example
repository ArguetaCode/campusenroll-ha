# ---------------------------------------------------------------------------
# CampusEnroll-HA - Ejemplo de variables para Docker local y LAN distribuida
# ---------------------------------------------------------------------------

# Base de datos
DB_HOST=campusenroll-postgres
DB_PORT=5432
DB_NAME=campusenroll
DB_USER=campus
DB_PASSWORD=campus123

# Redis
REDIS_HOST=campusenroll-redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_HOST=campusenroll-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=campus
RABBITMQ_PASSWORD=campus123

# URLs entre microservicios
STUDENT_SERVICE_URL=http://student-service:8081
COURSE_SERVICE_URL=http://course-service:8082
BILLING_SERVICE_URL=http://billing-service:8083
NOTIFICATION_SERVICE_URL=http://notification-service:8084

# Puertos por microservicio
STUDENT_SERVER_PORT=8081
COURSE_SERVER_PORT=8082
BILLING_SERVER_PORT=8083
NOTIFICATION_SERVER_PORT=8084
ENROLLMENT_SERVER_PORT=8085

# Compatibilidad para servicios que usan SERVER_PORT directo
SERVER_PORT=8085

# Gateway / Reverse proxy
GATEWAY_PORT=8080

# k6 / load test defaults
TEST_PROFILE=smoke
K6_VUS=
K6_DURATION=
INCLUDE_NOTIFICATION_CHECK=false

# k6 thresholds (pass/fail en pipeline)
K6_THRESHOLD_FAILURE_RATE=rate<0.01
K6_THRESHOLD_P95_DURATION=p(95)<1200
K6_THRESHOLD_CHECKS_RATE=rate>0.99
