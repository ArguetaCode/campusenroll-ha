# CampusEnroll-HA LAN infra node example
# Copy to .env on the infra node and replace placeholders.

DB_HOST=campusenroll-postgres
DB_PORT=5432
DB_NAME=campusenroll
DB_USER=campus
DB_PASSWORD=campus123

REDIS_HOST=campusenroll-redis
REDIS_PORT=6379

RABBITMQ_HOST=campusenroll-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=campus
RABBITMQ_PASSWORD=campus123

GATEWAY_PORT=8080

# Informational LAN address for documentation and scripts.
INFRA_NODE_HOST=192.168.1.10
