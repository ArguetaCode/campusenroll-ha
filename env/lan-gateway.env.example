# CampusEnroll-HA LAN gateway node example
# Copy to .env on the gateway node and replace placeholders.

GATEWAY_PORT=8080

# Optional: switch the gateway config file (default is ./api-gateway/nginx.conf).
# For LAN upstreams, you can generate a config with scripts/gateway-generate-nginx-lan.ps1
# and point this variable to it.
# Example:
# GATEWAY_NGINX_CONF=./api-gateway/nginx.lan.generated.conf

# Optional: LAN upstream lists used by scripts/gateway-generate-nginx-lan.ps1
# Format: host:port,host:port
# The last server is marked as 'backup' when you provide 2+ servers.
STUDENT_SERVICE_UPSTREAMS=192.168.0.13:8081
COURSE_SERVICE_UPSTREAMS=192.168.0.13:8082
BILLING_SERVICE_UPSTREAMS=192.168.0.13:8083
NOTIFICATION_SERVICE_UPSTREAMS=192.168.0.13:8084
ENROLLMENT_SERVICE_UPSTREAMS=192.168.0.13:8085

# PostgreSQL HA endpoint exposed by HAProxy on PC Extra.
DB_HOST=192.168.0.13
DB_PORT=5000
DB_NAME=campusenroll
DB_USER=campus
DB_PASSWORD=campus123

SPRING_DATASOURCE_URL=jdbc:postgresql://192.168.0.13:5000/campusenroll
SPRING_DATASOURCE_USERNAME=campus
SPRING_DATASOURCE_PASSWORD=campus123

REDIS_HOST=192.168.0.13
REDIS_PORT=6379

RABBITMQ_HOST=192.168.0.13
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=campus
RABBITMQ_PASSWORD=campus123

# Service endpoints used by enrollment-service if it runs on this node.
STUDENT_SERVICE_URL=http://192.168.0.13:8081
COURSE_SERVICE_URL=http://192.168.0.13:8082
BILLING_SERVICE_URL=http://192.168.0.13:8083
NOTIFICATION_SERVICE_URL=http://192.168.0.13:8084
