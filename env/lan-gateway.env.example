# CampusEnroll-HA LAN gateway node example
# Copy to .env on the gateway node and replace placeholders.

GATEWAY_PORT=8080

# Optional: switch the gateway config file (default is ./api-gateway/nginx.conf).
# For LAN upstreams, you can generate a config with scripts/gateway-generate-nginx-lan.ps1
# and point this variable to it.
# Example:
# GATEWAY_NGINX_CONF=./api-gateway/nginx.lan.generated.conf

# Optional: LAN upstream lists used by scripts/gateway-generate-nginx-lan.ps1
# Format: host:port,host:port
# The last server is marked as 'backup' when you provide 2+ servers.
STUDENT_SERVICE_UPSTREAMS=192.168.1.30:8081,192.168.1.31:8081
COURSE_SERVICE_UPSTREAMS=192.168.1.30:8082,192.168.1.31:8082
BILLING_SERVICE_UPSTREAMS=192.168.1.31:8083,192.168.1.30:8083
NOTIFICATION_SERVICE_UPSTREAMS=192.168.1.31:8084,192.168.1.30:8084
ENROLLMENT_SERVICE_UPSTREAMS=192.168.1.31:8085,192.168.1.30:8085

# Central infrastructure endpoints.
DB_HOST=192.168.1.10
DB_PORT=55432
DB_NAME=campusenroll
DB_USER=campus
DB_PASSWORD=campus123

REDIS_HOST=192.168.1.10
REDIS_PORT=6379

RABBITMQ_HOST=192.168.1.10
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=campus
RABBITMQ_PASSWORD=campus123

# Service endpoints used by enrollment-service if it runs on this node.
STUDENT_SERVICE_URL=http://192.168.1.30:8081
COURSE_SERVICE_URL=http://192.168.1.30:8082
BILLING_SERVICE_URL=http://192.168.1.31:8083
NOTIFICATION_SERVICE_URL=http://192.168.1.31:8084
