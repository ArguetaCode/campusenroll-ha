# CampusEnroll-HA Swarm example
# Copy to env/swarm.env on the deploying manager and adjust for your LAN.

STACK_NAME=campusenroll
GATEWAY_PUBLISHED_PORT=8080

# Image references available to every node.
# Recommended: push to a registry reachable from all 4 PCs.
STUDENT_SERVICE_IMAGE=campusenroll/student-service:swarm-latest
COURSE_SERVICE_IMAGE=campusenroll/course-service:swarm-latest
BILLING_SERVICE_IMAGE=campusenroll/billing-service:swarm-latest
NOTIFICATION_SERVICE_IMAGE=campusenroll/notification-service:swarm-latest
ENROLLMENT_SERVICE_IMAGE=campusenroll/enrollment-service:swarm-latest
API_GATEWAY_IMAGE=campusenroll/api-gateway:swarm-latest

# Existing infrastructure endpoints. These stay external/non-HA in this phase.
DB_HOST=192.168.1.10
DB_PORT=55432
DB_NAME=campusenroll
DB_USER=campus
DB_PASSWORD=campus123

REDIS_HOST=192.168.1.10
REDIS_PORT=6379

RABBITMQ_HOST=192.168.1.10
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=campus
RABBITMQ_PASSWORD=campus123

# Optional explicit service URLs for enrollment-service.
# Default to internal Swarm DNS names if omitted.
STUDENT_SERVICE_URL=http://student-service:8081
COURSE_SERVICE_URL=http://course-service:8082
BILLING_SERVICE_URL=http://billing-service:8083
NOTIFICATION_SERVICE_URL=http://notification-service:8084

# Optional local registry example:
# STUDENT_SERVICE_IMAGE=registry.campusenroll.lan:5000/student-service:swarm-latest

