# CampusEnroll-HA PostgreSQL primary node example
# This is a planning template. Full streaming replication setup is documented in docs/postgresql-ha-lab.md.

DB_HOST=campusenroll-postgres
DB_PORT=5432
DB_NAME=campusenroll
DB_USER=campus
DB_PASSWORD=campus123

POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=change-me-in-lab
POSTGRES_PRIMARY_HOST=192.168.1.10
POSTGRES_REPLICA_HOST=192.168.1.11
POSTGRES_WAL_ARCHIVE_DIR=/var/lib/postgresql/wal-archive
