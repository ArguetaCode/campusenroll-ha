# CampusEnroll-HA LAN microservices node example
# Copy to .env on a service node and replace placeholders.

DB_HOST=192.168.0.13
DB_PORT=5000
DB_NAME=campusenroll
DB_USER=campus
DB_PASSWORD=campus123

SPRING_DATASOURCE_URL=jdbc:postgresql://192.168.0.13:5000/campusenroll
SPRING_DATASOURCE_USERNAME=campus
SPRING_DATASOURCE_PASSWORD=campus123

REDIS_HOST=192.168.0.13
REDIS_PORT=6379

# RabbitMQ HA endpoint exposed by HAProxy on PC Extra.
RABBITMQ_HOST=192.168.0.13
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=campus
RABBITMQ_PASSWORD=campus123

# Internal Docker Compose service URLs used by enrollment-service.
STUDENT_SERVICE_URL=http://student-service:8081
COURSE_SERVICE_URL=http://course-service:8082
BILLING_SERVICE_URL=http://billing-service:8083
NOTIFICATION_SERVICE_URL=http://notification-service:8084

STUDENT_SERVER_PORT=8081
COURSE_SERVER_PORT=8082
BILLING_SERVER_PORT=8083
NOTIFICATION_SERVER_PORT=8084
ENROLLMENT_SERVER_PORT=8085
